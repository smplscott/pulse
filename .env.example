# Postgres connection string (any standard Postgres — local, Docker, Neon, Supabase, RDS, etc.)
DATABASE_URL=postgresql://user:password@localhost:5432/pulse

# Secret used to sign session cookies — set to a long random string in production
SESSION_SECRET=change-me

# Spotify Web API (Client Credentials) — artist/album search & catalog enrichment only.
# Not used for user login/OAuth. Required for Global Search and album/artist flows.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Ticketmaster Discovery API — wishlist × trip upcoming-show matching
TICKETMASTER_API_KEY=

# Shared secret for POST /api/internal/jobs/scan-wishlist-matches (Railway cron)
CRON_SECRET=

# Setlist.fm API — optional fallback for past show search when Ticketmaster returns no results
SETLISTFM_API_KEY=

# Google Places API (New) — server-side city and place autocomplete
# Enable billing + Places API (New), and restrict the key to that API.
GOOGLE_PLACES_API_KEY=

# Google Maps Static API — server-side place detail snapshots (optional).
# Enable Maps Static API on the same project. Falls back to GOOGLE_PLACES_API_KEY
# if that key is allowed to call Static Maps.
GOOGLE_MAPS_API_KEY=

NODE_ENV=development
